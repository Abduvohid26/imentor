# Production — copy to deploy/.env.production on the server (never commit .env.production).

# Kamida 40 tasodifiy belgi:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=

POSTGRES_DB=imentor
POSTGRES_USER=imentor
POSTGRES_PASSWORD=

DJANGO_ALLOWED_HOSTS=imentor.uz,www.imentor.uz,api.imentor.uz,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://imentor.uz,https://www.imentor.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://imentor.uz,https://www.imentor.uz,https://api.imentor.uz

# Bir domen: /api — imentor.uz orqali
VITE_API_BASE_URL=/api

OPENAI_API_KEY=

ADMIN_PHONE=998907863888
ADMIN_PASSWORD=
DEMO_ADMIN_PHONES=998907863888

# Host nginx → Docker gateway (127.0.0.1:31001)
IMENTOR_HTTP_BIND=127.0.0.1
IMENTOR_HTTP_PORT=31001
