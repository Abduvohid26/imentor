ADMIN_PHONE=998907863888
ADMIN_PASSWORD=
DEMO_ADMIN_PHONES=998907863888,998901110001

DJANGO_ALLOW_OPEN_REGISTRATION=True
DJANGO_ENSURE_DEMO_USERS=True
DJANGO_BEHIND_PROXY=True

# Demo test hisoblar (dev bilan bir xil)
DEMO_ADMIN_PHONE=998901110001
