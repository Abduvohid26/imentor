POSTGRES_PASSWORD=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

VITE_API_BASE_URL=/api
OPENAI_API_KEY=

ADMIN_PHONE=998907863888
ADMIN_PASSWORD=
DEMO_ADMIN_PHONES=998907863888

# SSL yoqilmaguncha (http://IP:port) — False; host nginx + HTTPS dan keyin True ga o'zgartiring
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False

# 0.0.0.0 = tashqi IP orqali ham ochiladi; faqat host nginx bo'lsa 127.0.0.1
IMENTOR_HTTP_BIND=0.0.0.0
IMENTOR_HTTP_PORT=9050
