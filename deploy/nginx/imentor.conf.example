# Host nginx → Docker gateway (bitta port: SPA + /api + /media)
# Copy to /etc/nginx/sites-available/imentor
#
# Docker gateway: 127.0.0.1:31001 (docker-compose.prod.yml)
# Upstream faqat gateway — alohida frontend/backend portlari yo'q.

upstream imentor_gateway {
    server 127.0.0.1:31001;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name imentor.uz www.imentor.uz api.imentor.uz;

    client_max_body_size 25m;

    location / {
        proxy_pass http://imentor_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
