# Rename to .env.deploy.local (gitignored). Never commit real passwords.
#
# Yoki GitHub: repo → Settings → Actions → Variables: SSH_DEPLOY_ENABLED=true
# va Secrets: SSH_HOST, SSH_USER, SSH_PRIVATE_KEY — keyin push bilan avtomatik deploy
# (.github/workflows/deploy-production.yml).
#
SSH_HOST=164.90.186.193
SSH_USER=root
SSH_PASSWORD=
SSH_KEY_PATH=
REMOTE_REPO_PATH=/opt/imentor
GIT_REPO_URL=https://github.com/aiziyrak-coder/imentor.git
# deploy/remote_deploy.py: qaysi branch (default: main)
GIT_REF=main
# Serverda health tekshiruvi (docker gateway port)
IMENTOR_HTTP_PORT=31001

